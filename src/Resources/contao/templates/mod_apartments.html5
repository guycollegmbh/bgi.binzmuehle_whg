<?php
use Contao\FilesModel;
use Contao\Controller;
use Contao\System;
?>

<?php $this->extend('block_searchable'); ?>

<?php $this->block('content'); ?>

    <?php 
      // Get database connection from container
      $connection = System::getContainer()->get('database_connection');
    ?>

    <div class="frow-container filter">
        <div class="frow gutters content-start">
            <div class="col-xs-1-1">
                <div class="filterAngebotstyp Radio">
                    <!--Filter Angebotstyp-->
                    <?php
                        $angebotstypen = $connection->executeQuery('SELECT alias, angebotstyp FROM tl_angebotstypen ORDER BY angebotstyp')->fetchAllAssociative();
                        $selectedAlias = !empty($service['angebotstyp']) ? $service['angebotstyp'] : '';

                        foreach ($angebotstypen as $typ) {
                            $checked = ($selectedAlias == $typ['alias']) ? ' checked' : '';
                            $id = 'angebotstyp_' . $typ['alias'];
                            
                            echo '<div class="radio-wrapper">';
                            echo '<input type="radio" id="' . $id . '" name="angebotstyp" value=".' . $typ['alias'] . '"' . $checked . '>';
                            echo '<label for="' . $id . '">' . htmlspecialchars($typ['angebotstyp']) . '</label><br>';
                            echo '</div>';
                        }
                    ?>
                </div>

                <!--Filter Zuweisende Stelle-->
                <div class="filterZuweisendestelle select">
                    <?php
                        $stellen = $connection->executeQuery('SELECT alias, zuweisendestelle FROM tl_zuweisendestellen ORDER BY zuweisendestelle')->fetchAllAssociative();
                        $selectedAlias = !empty($service['zuweisendestelle']) ? $service['zuweisendestelle'] : '';

                        echo '<select name="zuweisendestelle" id="zuweisendestelle" class="form-control" value-group="zuweisendestelle">';
                        echo '<option value="">Zuweisende Stelle</option>';

                        foreach ($stellen as $stelle) {
                            $selected = ($selectedAlias == $stelle['alias']) ? ' selected' : '';
                            echo '<option value=".' . $stelle['alias'] . '"' . $selected . '>' . 
                                htmlspecialchars($stelle['zuweisendestelle']) . '</option>';
                        }

                        echo '</select>';
                    ?>
                </div>    

                <!--Filter Zielgruppe-->
                <div class="filterZielgruppe select">
                    <?php
                        $zielgruppen = $connection->executeQuery('SELECT alias, zielgruppe FROM tl_zielgruppen ORDER BY zielgruppe')->fetchAllAssociative();
                        $selectedAlias = !empty($service['zielgruppe']) ? $service['zielgruppe'] : '';

                        echo '<select name="zielgruppe" id="zielgruppe" class="form-control" value-group="zielgruppe">';
                        echo '<option value="">Zielgruppe</option>';

                        foreach ($zielgruppen as $zg) {
                            $selected = ($selectedAlias == $zg['alias']) ? ' selected' : '';
                            echo '<option value=".' . $zg['alias'] . '"' . $selected . '>' . 
                                htmlspecialchars($zg['zielgruppe']) . '</option>';
                        }

                        echo '</select>';
                    ?>
                </div>  
            </div>
        </div>
    </div>

    <!-- Akkordeon -->
    <div class="accordion-wrapper<?php if ($this->class): ?> <?= $this->class ?><?php endif; ?>">
    <?php foreach ($this->services as $service): 
        if ($service['published'] == 1): ?>
  
        <?php 
        // Zugewiesene Stellen (Stelle & Alias) für Ausgabe Listing und Fiter in Variabeln speichern
        $zuweisendeStellenNamen = [];
        $zuweisendeStellenAliase = [];

        if (!empty($service['zuweisendestelle'])):
            // Versuche die serialisierten Werte zu deserialisieren
            $selectedStellen = @unserialize($service['zuweisendestelle']);
            
            // Wenn es ein String ist (einzelne Auswahl), konvertiere zu Array
            if (!is_array($selectedStellen)) {
                $selectedStellen = [$selectedStellen];
            }
            
            if (!empty($selectedStellen)):
                // Hole alle ausgewählten Stellen
                $results = $connection->executeQuery(
                    'SELECT zuweisendestelle, alias FROM tl_zuweisendestellen WHERE id IN (?)',
                    [$selectedStellen],
                    [\Doctrine\DBAL\Connection::PARAM_INT_ARRAY]
                )->fetchAllAssociative();
                
                if (!empty($results)):
                    foreach ($results as $stelle): 
                        $stellenName = $stelle['zuweisendestelle'];
                        $stellenAlias = $stelle['alias'];
                        
                        // Sammeln der Werte in Arrays
                        $zuweisendeStellenNamen[] = $stellenName;
                        $zuweisendeStellenAliase[] = $stellenAlias;
                    endforeach;
                endif;
            endif;
        endif;
  

        // Angebotstyp (Alias) für Filter in Variabel speichern
        $angebotsTypAliase = [];

        if (!empty($service['angebotstyp'])):
            // Deserialisiere den BLOB-Wert
            $selectedAngebotstypen = @unserialize($service['angebotstyp']);
            
            // Wenn es ein String ist (einzelne Auswahl), konvertiere zu Array
            if (!is_array($selectedAngebotstypen)) {
                $selectedAngebotstypen = [$selectedAngebotstypen];
            }
            
            if (!empty($selectedAngebotstypen)):
                // Hole nur die Aliase der ausgewählten Angebotstypen
                $results = $connection->executeQuery(
                    'SELECT alias FROM tl_angebotstypen WHERE id IN (?)',
                    [$selectedAngebotstypen],
                    [\Doctrine\DBAL\Connection::PARAM_INT_ARRAY]
                )->fetchAllAssociative();
                
                if (!empty($results)):
                    foreach ($results as $typ): 
                        $angebotsTypAliase[] = $typ['alias'];
                    endforeach;
                    
                    // Ausgabe mit Leerzeichen
                    
                endif;
            endif;
        endif;

   
        $zielgruppeAlias = '';
        // Zielgruppe (Alias) für Filter in Variabel speichern
        if (!empty($service['zielgruppe'])):
            // Hole den Alias für die ausgewählte Zielgruppe
            $zielgruppeAlias = $connection->executeQuery(
                'SELECT alias FROM tl_zielgruppen WHERE id = ?',
                [$service['zielgruppe']],
                [\PDO::PARAM_INT]
            )->fetchOne();
        endif;
        ?>

        <!-- Akkordeon Item -->
        <div class="accordion-item 
            <?php foreach ($angebotsTypAliase as $angebotsTypAlias): ?><?= htmlspecialchars($angebotsTypAlias) ?> <?php endforeach; ?><?php foreach($zuweisendeStellenAliase as $zuweisendeStellenAlias): ?><?= htmlspecialchars($zuweisendeStellenAlias) ?> <?php endforeach; ?><?php echo $zielgruppeAlias; ?>">
            <div class="accordion-header">
                <div class="frow-container">
                    <div class="frow gutters content-start">
                        <div class="col-md-1-1">
                            <div class="bordertop"></div>
                        </div>
                        <div class="col-md-8-12 left">
                            <?php if (!empty($service['marketingtitel'])): ?>
                                <div class="marketingtitel"><?= $service['marketingtitel'] ?></div>
                            <?php endif; ?>
                        </div>
                        <div class="col-md-4-12 right">
                            <?php if (!empty($service['zuweisendestelle'])): ?>
                                <div class="zuweisendestelle">
                                <?php foreach($zuweisendeStellenNamen as $stelle): ?>
                                    <?= htmlspecialchars($stelle) ?>
                                <?php endforeach; ?>
                                </div>
                            <?php endif; ?>
                            
                            <div class="divider">|</div>

                            <?php if (!empty($service['standort'])): ?>
                                <div class="standort"><?= htmlspecialchars($service['standort']) ?></div>
                            <?php endif; ?>
                        </div>
                    </div>
                </div>        
			</div>

            <div class="accordion-body">
                <div class="frow-container">
                    <div class="frow gutters content-start">
                        <div class="col-md-8-12">
                            <?php if (!empty($service['beschreibung'])): ?>
                                <div class="beschreibung"><?= $service['beschreibung'] ?></div>
                            <?php endif; ?>
                        </div>

                        <div class="col-md-4-12">
                            <?php if (!empty($service['detailseite'])): ?>                 
                                <div class="linkdetails"><a href="{{link_url::<?php echo $service['detailseite']; ?>}}" <?php if ($service['target'] == 1): ?>target="_blank"<?php endif; ?>>Mehr Informationen</a></div>
                            <?php endif; ?>
                            <?php if (!empty($service['linkueberschrift'])): ?>
                                <div class="linkueberschrift"><?= $service['linkueberschrift'] ?></div>
                            <?php endif; ?>
                                
                            <div class="multilinks">
                                <?php
                                $links = @unserialize($service['links']);
                                if ($links && is_array($links)) {
                                    foreach ($links as $link) {
                                        if (is_array($link) && 
                                            isset($link['linktext']) && 
                                            isset($link['linktitel']) && 
                                            isset($link['linkurl'])) {                  
                                            $isExternal = (isset($link['linkblank']) && $link['linkblank'] == 1);
                                            $targetBlank = $isExternal ? ' target="_blank"' : '';
                                            $externClass = $isExternal ? ' class="extern"' : ''; 
                                            echo '<div class="linkitem">';
                                            echo sprintf(
                                                '<a href="%s" title="%s"%s%s>%s</a>',
                                                htmlspecialchars($link['linkurl']),
                                                htmlspecialchars($link['linktitel']),
                                                $targetBlank,
                                                $externClass,
                                                htmlspecialchars($link['linktext'])
                                            );
                                            echo '</div>';
                                        }
                                    }
                                }
                                ?>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ALT KANN GELÖSCHT WERDEN -->
                <!--<?php if (!empty($service['titel'])): ?>
                    <div class="titel"> <?= htmlspecialchars($service['titel']) ?></div>
                    <?php endif; ?>

                <?php $objFile = FilesModel::findByUuid($service['seitenbild']);
                if ($objFile !== null) {
                    $imagePath = $objFile->path;
                    echo '<img class="seitenbild" src="'.$imagePath.'" />';
                }?>

                <?php if (!empty($service['zielgruppe'])) {
                    $resultZielgruppe = $connection->executeQuery('SELECT * FROM tl_zielgruppen WHERE id=?',[$service['zielgruppe']],[\PDO::PARAM_INT])->fetchAssociative();
                    echo '<p>Zielgruppe: ' . htmlspecialchars($resultZielgruppe['zielgruppe']) . '</p>';
                }?>-->     
            </div>
            
        </div>
        
      <?php endif; ?>
    <?php endforeach; ?> 
    </div>

    <div class="infotext-wrapper">
        <div class="frow-container">
            <div class="frow gutters content-start">
                <div class="col-md-1-1">
                    <div class="auswahltext">
                        <p>Treffen Sie eine Auswahl.</p>
                    </div>
                    <div class="noentries">
                        <p>Keine Einträge gefunden.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

<?php $this->endblock(); ?>