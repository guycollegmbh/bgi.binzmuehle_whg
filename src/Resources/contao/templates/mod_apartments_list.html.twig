<link rel="stylesheet" href="{{ asset('bundles/apartments/css/apartments_list.css') }}">

<div class="mod_apartments_list">

    {# ========== PREVIEW & FILTER CONTAINER (2-spaltig) ========== #}
    <div class="preview-filter-container">

        {# ========== LINKE SPALTE: ETAGENPLAN VORSCHAU ========== #}
        <div class="preview-column">
