                             class="preview-image">
                        <img id="preview-etage"
                             src=""
                             alt=""
                             class="preview-image-overlay">
                        <svg class="lageplan-overlay" viewBox="0 0 650 400" overflow="visible" xmlns="http://www.w3.org/2000/svg">
                            <!-- Bauetappe 2 Header (über Zeile 4+5) -->
                            <text x="190" y="0" text-anchor="middle" font-size="16" font-weight="bold" fill="#777">Bauetappe 2</text>
                            <!-- Bauetappe 1 Header (über Zeile 1-3) -->
                            <text x="540" y="0" text-anchor="middle" font-size="16" font-weight="bold" fill="#555">Bauetappe 1: Bezug Herbst 2027</text>
                            <!-- Zeile Labels (alle, über den Gebäuden) -->
                            <text x="110" y="38" text-anchor="middle" font-size="16" font-weight="bold" fill="#333">Zeile 5</text>
                            <text x="260" y="38" text-anchor="middle" font-size="16" font-weight="bold" fill="#333">Zeile 4</text>
                            <text x="403" y="38" text-anchor="middle" font-size="16" font-weight="bold" fill="#333">Zeile 3</text>
