                            <text x="670" y="38" text-anchor="middle" font-size="16" font-weight="bold" fill="#333">Zeile 1</text>
                            <!-- Binderweg vertikal (Lücke zwischen Zeile 5 und Zeile 4) -->
                            <text x="125" y="185" text-anchor="middle" font-size="16" font-weight="bold" fill="#777" transform="rotate(-90, 217, 215)">Binderweg</text>
                            <!-- Zelghalde vertikal (Lücke zwischen Zeile 3 und Zeile 2) -->
                            <text x="345" y="255" text-anchor="middle" font-size="16" font-weight="bold" fill="#777" transform="rotate(-90, 439, 215)">Zelghalde</text>
                            <!-- Hausnummern Zeile 1 (Kügeliloostrasse) -->
                            <text x="730" y="93"  text-anchor="middle" font-size="12" font-weight="bold" fill="#555">69</text>
                            <text x="730" y="175" text-anchor="middle" font-size="12" font-weight="bold" fill="#555">67</text>
                            <text x="730" y="303" text-anchor="middle" font-size="12" font-weight="bold" fill="#555">65</text>
                            <!-- Hausnummern Zeile 2 (Zelghalde, gerade) -->
                            <text x="483" y="93"  text-anchor="middle" font-size="12" font-weight="bold" fill="#555">38</text>
                            <text x="492" y="175" text-anchor="middle" font-size="12" font-weight="bold" fill="#555">36</text>
                            <text x="484" y="245" text-anchor="middle" font-size="12" font-weight="bold" fill="#555">34</text>
                            <text x="517" y="290" text-anchor="middle" font-size="12" font-weight="bold" fill="#555">32</text>
                            <text x="497" y="329" text-anchor="middle" font-size="12" font-weight="bold" fill="#555">30</text>
                            <!-- Hausnummern Zeile 3 (Zelghalde, ungerade) -->
                            <text x="466" y="93"  text-anchor="middle" font-size="12" font-weight="bold" fill="#555">39</text>
                            <text x="460" y="175" text-anchor="middle" font-size="12" font-weight="bold" fill="#555">37</text>
                            <text x="467" y="245" text-anchor="middle" font-size="12" font-weight="bold" fill="#555">35</text>
                            <text x="433" y="290" text-anchor="middle" font-size="12" font-weight="bold" fill="#555">33</text>
                            <text x="453" y="329" text-anchor="middle" font-size="12" font-weight="bold" fill="#555">31</text>
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        {# ========== RECHTE SPALTE: GESCHOSS-VORSCHAU + FILTER ========== #}
        <div class="filter-column">

            {# Geschoss-Vorschau #}
            <div class="preview-box geschoss-preview-box">
                <div class="preview-image-wrapper">
                    <img id="preview-geschoss"
                         src="files/apartments/defaults/defaultgeschoss.png"
                         alt="Geschoss Vorschau"
                         class="preview-image">
                </div>
            </div>

            <div class="filter-section">
        <form method="get" class="filter-form">
            <div class="filter-group">
                <label for="status">Status:</label>
                <select name="status" id="status">
                    <option value="">Alle</option>
                    {% for option in statusOptions %}
                        <option value="{{ option.status }}" {% if (currentStatus == option.status) or (currentStatus is empty and option.status == 'Frei') %}selected{% endif %}>
                            {{ option.status }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="filter-group">
                <label for="zimmer">Zimmer:</label>
                <select name="zimmer" id="zimmer">
                    <option value="">Alle</option>
                    {% for option in zimmerOptions %}
                        <option value="{{ option.zimmer }}" {% if currentZimmer == option.zimmer %}selected{% endif %}>
                            {% if option.zimmer == '1' %}Jokerzimmer{% else %}{{ option.zimmer }}{% endif %}
                        </option>
                    {% endfor %}
                </select>
            </div>

            {# TODO SPÄTER WIEDER EINBLENDEN: Bauetappe-Filter - START #}
            {# <div class="filter-group">
                <label for="bauetappe">Bauetappe:</label>
                <select name="bauetappe" id="bauetappe">
                    <option value="">Alle</option>
                    {% for option in bauetappeOptions %}
                        <option value="{{ option.bauetappe }}" {% if currentBauetappe == option.bauetappe %}selected{% endif %}>
                            {{ option.bauetappe }}
                        </option>
                    {% endfor %}
                </select>
            </div> #}
            {# TODO SPÄTER WIEDER EINBLENDEN: Bauetappe-Filter - ENDE #}

            <div class="filter-group">
                <label for="zeile">Zeile:</label>
                <select name="zeile" id="zeile">
                    <option value="">Alle</option>
                    {% for option in zeileOptions %}
                        <option value="{{ option.zeile }}" {% if currentZeile == option.zeile %}selected{% endif %}>
                            {% if option.zeile == 'Zeile 1' %}Zeile 1: Kügeliloostrasse
                            {% elseif option.zeile == 'Zeile 2' %}Zeile 2: Zelghalde
                            {% elseif option.zeile == 'Zeile 3' %}Zeile 3: Zelghalde
                            {% else %}{{ option.zeile }}{% endif %}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="filter-group">
                <label for="etage">Etage:</label>
                <select name="etage" id="etage">
                    <option value="">Alle</option>
                    {% for option in etageOptions %}
                        <option value="{{ option.etage }}" {% if currentEtage == option.etage %}selected{% endif %}>
                            {{ option.etage }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="filter-group price-slider-group">
                <label>Bruttomiete:</label>
                <div class="price-values">
                    CHF <span id="minPriceDisplay">{{ currentMinPreis }}</span> - <span id="maxPriceDisplay">{{ currentMaxPreis }}</span>
                </div>
                <div class="dual-range-wrapper">
                    <input type="range" id="minPrice" name="minPrice" min="{{ minPreis }}" max="{{ maxPreis }}" step="50" value="{{ currentMinPreis }}" class="range-slider">
                    <input type="range" id="maxPrice" name="maxPrice" min="{{ minPreis }}" max="{{ maxPreis }}" step="50" value="{{ currentMaxPreis }}" class="range-slider">
                </div>
            </div>

            <a href="/liste" class="btn-reset">Filter zurücksetzen</a>
        </form>
            </div>
        </div>

    </div>

    {# Apartments Table #}
    <div class="table-container">
        <table id="apartments-table" class="display">
            <thead>
                <tr>
                    <th>Objektnummer</th>
                    <th>Bezeichnung</th>
                    <th>Bauetappe</th>
                    <th class="hidden-column">Zeile</th>
                    <th>Adresse</th>
                    <th>Etage</th>
                    <th>Zimmer</th>
                    <th>ca. Fläche (m²)</th>
                    {# TODO SPÄTER WIEDER EINBLENDEN: Nettomiete - START #}
                    {# <th>Nettomiete</th> #}
                    {# TODO SPÄTER WIEDER EINBLENDEN: Nettomiete - ENDE #}
                    {# TODO SPÄTER WIEDER EINBLENDEN: Nebenkosten - START #}
                    {# <th>Nebenkosten</th> #}
                    {# TODO SPÄTER WIEDER EINBLENDEN: Nebenkosten - ENDE #}
                    <th>Bruttomiete</th>
                    <th>Status</th>
                    {# TODO SPÄTER WIEDER EINBLENDEN: Grundriss PDF - START #}
                    {# <th>Grundriss</th> #}
                    {# TODO SPÄTER WIEDER EINBLENDEN: Grundriss PDF - ENDE #}
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for apartment in apartments %}
                    <tr data-grundriss="{{ apartment.imagegrundriss_path|default('') }}"
                        data-etage="{{ apartment.imageetage_path|default('') }}"
                        data-geschoss="{{ apartment.etage|default('') }}"
                        data-url="wohnungen/details?id={{ apartment.objektnummer_url }}"
                        class="apartment-row">
                        <td data-label="Objekt">{{ apartment.objektnummer }}<span class="mobile-status status-badge status-{{ apartment.status|lower|replace({' ': '-'}) }}">{{ apartment.status }}</span></td>
                        <td data-label="Bezeichnung">{{ apartment.bezeichnung }}</td>
                        <td data-label="Bauetappe">{{ apartment.bauetappe }}</td>
                        <td class="hidden-column" data-label="Zeile">{{ apartment.zeile }}</td>
                        <td data-label="Adresse">{{ apartment.adresse }}</td>
                        <td data-label="Etage" data-order="{{ {'UG': 0, 'EG': 1, 'EG/1.OG': 2, 'EG/ 1.OG': 2, '1.OG': 3, '2.OG': 4, '3.OG': 5, 'DG': 6}[apartment.etage] ?? 9 }}">{{ apartment.etage }}</td>
                        <td data-label="Zimmer">{{ apartment.zimmer }}</td>
                        <td data-label="Fläche">{{ apartment.flaeche }} m²</td>
                        {# TODO SPÄTER WIEDER EINBLENDEN: Nettomiete - START #}
                        {# <td>{{ apartment.nettomietzins }}</td> #}
                        {# TODO SPÄTER WIEDER EINBLENDEN: Nettomiete - ENDE #}
                        {# TODO SPÄTER WIEDER EINBLENDEN: Nebenkosten - START #}
                        {# <td>{{ apartment.nebenkosten }}</td> #}
                        {# TODO SPÄTER WIEDER EINBLENDEN: Nebenkosten - ENDE #}
                        <td data-label="Bruttomiete">CHF {{ apartment.bruttomietzins }}</td>
                        <td data-label="Status">
                            <span class="status-badge status-{{ apartment.status|lower|replace({' ': '-'}) }}">
                                {{ apartment.status }}
                            </span>
                        </td>
                        {# TODO SPÄTER WIEDER EINBLENDEN: Grundriss PDF - START #}
                        {# <td class="text-center">
                            {% if apartment.grundrisspdf_path %}
                                <a href="{{ apartment.grundrisspdf_path }}" class="btn-download" download title="Grundriss herunterladen">📥 PDF</a>
                            {% else %}
                                -
                            {% endif %}
                        </td> #}
                        {# TODO SPÄTER WIEDER EINBLENDEN: Grundriss PDF - ENDE #}
                        <td data-label="" class="text-center">
                            <a href="wohnungen/details?id={{ apartment.objektnummer_url }}" class="btn-details">Details</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

