<div class="mod_apartments_list">
    {% if apartments is empty %}
        <p class="no-apartments">Aktuell sind keine Wohnungen verfügbar.</p>
    {% else %}
        <!-- Filter-Bereich oberhalb der Tabelle -->
        <div class="apartments-filters">
            <h3>Filter</h3>
            
            <!-- Select-Filter in einer Reihe -->
            <div class="filter-grid">
                <!-- Adresse Filter -->
                <div class="filter-item">
                    <label for="filter-adresse">Adresse</label>
                    <select id="filter-adresse" class="filter-select">
                        <option value="">Alle</option>
                    </select>
                </div>

                <!-- Zeile Filter -->
                <div class="filter-item">
                    <label for="filter-zeile">Zeile</label>
                    <select id="filter-zeile" class="filter-select">
                        <option value="">Alle</option>
                    </select>
                </div>

                <!-- Etage Filter -->
                <div class="filter-item">
                    <label for="filter-etage">Etage</label>
                    <select id="filter-etage" class="filter-select">
                        <option value="">Alle</option>
                    </select>
                </div>

                <!-- Status Filter -->
                <div class="filter-item">
                    <label for="filter-status">Status</label>
                    <select id="filter-status" class="filter-select">
                        <option value="">Alle</option>
                    </select>
                </div>
            </div>

            <!-- Nettomiete Range Slider darunter -->
            <div class="filter-range">
                <label>Nettomiete: <span id="min-display">0</span> CHF - <span id="max-display">5000</span> CHF</label>
                <div class="range-slider-container">
                    <input type="range" id="min-price" min="0" max="5000" step="50" value="0" class="range-input">
                    <input type="range" id="max-price" min="0" max="5000" step="50" value="5000" class="range-input">
                </div>
            </div>

            <!-- Reset Button -->
            <div class="filter-actions">
                <button id="reset-filters" class="btn-reset">Alle Filter zurücksetzen</button>
            </div>
        </div>

        <!-- Tabelle -->
        <div class="table-responsive">
            <table id="apartments-table" class="apartments-table display">
                <thead>
                    <tr>
                        <th>Objekt-Nr.</th>
                        <th>Bezeichnung</th>
                        <th>Adresse</th>
                        <th>Zeile</th>
                        <th>Etage</th>
                        <th>Zimmer</th>
                        <th>Fläche</th>
                        <th>Nettomiete</th>
                        <th>Nebenkosten</th>
                        <th>Bruttomiete</th>
                        <th>Status</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    {% for apartment in apartments %}
                        <tr>
                            <td>{{ apartment.objektnummer|default('-') }}</td>
                            <td>{{ apartment.bezeichnung|default('-') }}</td>
                            <td>{{ apartment.adresse|default('-') }}</td>
                            <td>{{ apartment.zeile|default('-') }}</td>
                            <td>{{ apartment.etage|default('-') }}</td>
                            <td data-order="{{ apartment.zimmer|default('0') }}">{{ apartment.zimmer|default('-') }}</td>
                            <td data-order="{{ apartment.flaeche|default('0') }}">{{ apartment.flaeche ? apartment.flaeche ~ ' m²' : '-' }}</td>
                            <td data-order="{{ apartment.nettomietzins|default('0')|replace({'CHF ': '', ',': '', '.': ''}) }}">{{ apartment.nettomietzins ? 'CHF ' ~ apartment.nettomietzins : '-' }}</td>
                            <td data-order="{{ apartment.nebenkosten|default('0')|replace({'CHF ': '', ',': '', '.': ''}) }}">{{ apartment.nebenkosten ? 'CHF ' ~ apartment.nebenkosten : '-' }}</td>
                            <td data-order="{{ apartment.bruttomietzins|default('0')|replace({'CHF ': '', ',': '', '.': ''}) }}">{{ apartment.bruttomietzins ? 'CHF ' ~ apartment.bruttomietzins : '-' }}</td>
                            <td>
                                {% if apartment.status %}
                                    <span class="badge status-{{ apartment.status|lower }}">{{ apartment.status }}</span>
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td>
                                <a href="detail?id={{ apartment.objektnummer_url }}" class="btn-details">Details</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- DataTables CSS -->
        <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css">

        <!-- jQuery -->
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        
        <!-- DataTables JS -->
        <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>

       <script>
        (function($) {
            'use strict';
            
            $(document).ready(function() {
                var minPriceInput = document.getElementById('min-price');
                var maxPriceInput = document.getElementById('max-price');
                var minDisplay = document.getElementById('min-display');
                var maxDisplay = document.getElementById('max-display');

                // DataTables initialisieren
                var table = $('#apartments-table').DataTable({
                    language: {
                        url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/de-DE.json'
                    },
                    pageLength: 25,
                    lengthChange: false,
                    searching: true,
                    dom: 'rtip',
                    order: [[0, 'asc']]
                });

                // Funktion: Unique Werte extrahieren
                function getUniqueValues(columnIndex) {
                    var uniqueValues = [];
                    table.column(columnIndex).data().unique().each(function(d) {
                        var text;
                        if (typeof d === 'string' && d.indexOf('<') !== -1) {
                            var tempDiv = document.createElement('div');
                            tempDiv.innerHTML = d;
                            text = (tempDiv.textContent || tempDiv.innerText || '').trim();
                        } else {
                            text = (d || '').toString().trim();
                        }
                        
                        if (text && text !== '-' && uniqueValues.indexOf(text) === -1) {
                            uniqueValues.push(text);
                        }
                    });
                    return uniqueValues.sort();
                }

                // Filter-Dropdowns befüllen
                var filters = [
                    { id: 'filter-adresse', column: 2 },
                    { id: 'filter-zeile', column: 3 },
                    { id: 'filter-etage', column: 4 },
                    { id: 'filter-status', column: 10 }
                ];

                filters.forEach(function(filter) {
                    var select = $('#' + filter.id);
                    var values = getUniqueValues(filter.column);
                    
                    values.forEach(function(value) {
                        select.append('<option value="' + value + '">' + value + '</option>');
                    });

                    select.on('change', function() {
                        var val = $(this).val();
                        if (val) {
                            table.column(filter.column).search('^' + $.fn.dataTable.util.escapeRegex(val) + '$', true, false);
                        } else {
                            table.column(filter.column).search('');
                        }
                        table.draw();
                    });
                });

                // Range Slider für Nettomiete
                function updateRangeValues() {
                    var minVal = parseInt(minPriceInput.value);
                    var maxVal = parseInt(maxPriceInput.value);

                    if (minVal > maxVal) {
                        minPriceInput.value = maxVal;
                        minVal = maxVal;
                    }

                    minDisplay.textContent = minVal;
                    maxDisplay.textContent = maxVal;
                }

                // Custom Search für Nettomiete
                $.fn.dataTable.ext.search.push(
                    function(settings, data, dataIndex) {
                        var min = parseInt(minPriceInput.value);
                        var max = parseInt(maxPriceInput.value);
                        var nettomiete = parseFloat(data[7].replace(/[^0-9.-]+/g,"")) || 0;

                        return (nettomiete >= min && nettomiete <= max);
                    }
                );

                // Range Input Events
                minPriceInput.addEventListener('input', function() {
                    updateRangeValues();
                    table.draw();
                });

                maxPriceInput.addEventListener('input', function() {
                    updateRangeValues();
                    table.draw();
                });

                // Initial update
                updateRangeValues();

                // Reset Button
                $('#reset-filters').on('click', function() {
                    $('.filter-select').val('');
                    
                    filters.forEach(function(filter) {
                        table.column(filter.column).search('');
                    });
                    
                    minPriceInput.value = 0;
                    maxPriceInput.value = 5000;
                    updateRangeValues();
                    table.draw();
                });
            });
            
        })(jQuery);
        </script>
</div>