<div class="mod_apartments_list">
    {% if apartments is empty %}
        <p class="no-apartments">Aktuell sind keine Wohnungen verfügbar.</p>
    {% else %}
        <div class="table-responsive">
            <table class="apartments-table">
                <thead>
                    <tr>
                        <th>Objekt-Nr.</th>
                        <th>Bezeichnung</th>
                        <th>Adresse</th>
                        <th>Zeile</th>
                        <th>Etage</th>
                        <th>Zimmer</th>
                        <th>Fläche</th>
                        <th>Nettomiete</th>
                        <th>Nebenkosten</th>
                        <th>Bruttomiete</th>
                        <th>Status</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    {% for apartment in apartments %}
                        <tr class="{% if apartment.status %}status-{{ apartment.status|lower }}{% endif %}">
                            <td>{{ apartment.objektnummer|default('-') }}</td>
                            <td>{{ apartment.bezeichnung|default('-') }}</td>
                            <td>{{ apartment.adresse|default('-') }}</td>
                            <td>{{ apartment.zeile|default('-') }}</td>
                            <td>{{ apartment.etage|default('-') }}</td>
                            <td>{{ apartment.zimmer|default('-') }}</td>
                            <td>{{ apartment.flaeche ? apartment.flaeche ~ ' m²' : '-' }}</td>
                            <td>{{ apartment.nettomietzins ? 'CHF ' ~ apartment.nettomietzins : '-' }}</td>
                            <td>{{ apartment.nebenkosten ? 'CHF ' ~ apartment.nebenkosten : '-' }}</td>
                            <td>{{ apartment.bruttomietzins ? 'CHF ' ~ apartment.bruttomietzins : '-' }}</td>
                            <td>
                                {% if apartment.status %}
                                    <span class="badge status-{{ apartment.status|lower }}">{{ apartment.status }}</span>
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td>
                                <a href="wohnungen/details?id={{ apartment.objektnummer_url }}" class="btn btn-details">Details</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>