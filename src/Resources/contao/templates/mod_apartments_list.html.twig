<div class="mod_apartments_list">
    <div class="apartments-list">
        {% if apartments is empty %}
            <p class="no-apartments">Aktuell sind keine Wohnungen verfügbar.</p>
        {% else %}
            <div class="apartments-grid">
                {% for apartment in apartments %}
                    <div class="apartment-item{% if apartment.status %} status-{{ apartment.status|lower }}{% endif %}">
                        {% if apartment.bezeichnung %}
                            <h3>{{ apartment.bezeichnung }}</h3>
                        {% endif %}
                        {% if apartment.objektnummer %}
                            <span class="apartment-number">{{ apartment.objektnummer }}</span>
                        {% endif %}
                        
                        <div class="apartment-details">
                            {% if apartment.zimmer %}
                                <div class="detail-row">
                                    <strong>Zimmer:</strong> {{ apartment.zimmer }}
                                </div>
                            {% endif %}
                            {% if apartment.flaeche %}
                                <div class="detail-row">
                                    <strong>Fläche:</strong> {{ apartment.flaeche }} m²
                                </div>
                            {% endif %}
                            {% if apartment.bruttomietzins %}
                                <div class="detail-row">
                                    <strong>Miete:</strong> CHF {{ apartment.bruttomietzins }}
                                </div>
                            {% endif %}
                        </div>

                        {% if apartment.status %}
                            <div class="apartment-status status-{{ apartment.status|lower }}">
                                {{ apartment.status }}
                            </div>
                        {% endif %}

                        <div class="apartment-actions">
                            <a href="detail?id={{ apartment.id }}" class="btn btn-details">Details ansehen</a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>