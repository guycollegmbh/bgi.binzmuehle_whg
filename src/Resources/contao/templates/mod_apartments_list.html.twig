<div class="mod_apartments_list">
    {% if apartments is empty %}
        <p class="no-apartments">Aktuell sind keine Wohnungen verfügbar.</p>
    {% else %}
        <!-- Range-Slider für Nettomiete -->
        <div class="range-filter-slider">
            <h3>Nettomiete filtern</h3>
            <div id="nettomiete-slider"></div>
            <div class="slider-values">
                <span>von <strong id="min-value">0</strong> CHF</span>
                <span>bis <strong id="max-value">5000</strong> CHF</span>
            </div>
        </div>

        <div class="table-responsive">
            <table id="apartments-table" class="apartments-table display">
                <thead>
                    <tr>
                        <th>Objekt-Nr.</th>
                        <th>Bezeichnung</th>
                        <th>Adresse</th>
                        <th>Zeile</th>
                        <th>Etage</th>
                        <th>Zimmer</th>
                        <th>Fläche</th>
                        <th>Nettomiete</th>
                        <th>Nebenkosten</th>
                        <th>Bruttomiete</th>
                        <th>Status</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    {% for apartment in apartments %}
                        <tr class="{% if apartment.status %}status-{{ apartment.status|lower }}{% endif %}">
                            <td>{{ apartment.objektnummer|default('-') }}</td>
                            <td>{{ apartment.bezeichnung|default('-') }}</td>
                            <td>{{ apartment.adresse|default('-') }}</td>
                            <td>{{ apartment.zeile|default('-') }}</td>
                            <td>{{ apartment.etage|default('-') }}</td>
                            <td data-order="{{ apartment.zimmer|default('0') }}">{{ apartment.zimmer|default('-') }}</td>
                            <td data-order="{{ apartment.flaeche|default('0') }}">{{ apartment.flaeche ? apartment.flaeche ~ ' m²' : '-' }}</td>
                            <td data-order="{{ apartment.nettomietzins|default('0')|replace({'CHF ': '', ',': '', '.': ''}) }}">{{ apartment.nettomietzins ? 'CHF ' ~ apartment.nettomietzins : '-' }}</td>
                            <td data-order="{{ apartment.nebenkosten|default('0')|replace({'CHF ': '', ',': '', '.': ''}) }}">{{ apartment.nebenkosten ? 'CHF ' ~ apartment.nebenkosten : '-' }}</td>
                            <td data-order="{{ apartment.bruttomietzins|default('0')|replace({'CHF ': '', ',': '', '.': ''}) }}">{{ apartment.bruttomietzins ? 'CHF ' ~ apartment.bruttomietzins : '-' }}</td>
                            <td>
                                {% if apartment.status %}
                                    <span class="badge status-{{ apartment.status|lower }}">{{ apartment.status }}</span>
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td>
                                <a href="detail?id={{ apartment.objektnummer_url }}" class="btn-details">Details</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- DataTables CSS -->
        <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css">
        
        <!-- noUiSlider CSS -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.7.1/nouislider.min.css">

        <!-- jQuery -->
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        
        <!-- DataTables JS -->
        <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
        
        <!-- noUiSlider JS -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.7.1/nouislider.min.js"></script>

        <script>
        $(document).ready(function() {
            var minPrice = 0;
            var maxPrice = 5000;
            
            // Finde Min/Max aus den Daten
            {% if apartments %}
                var prices = [
                    {% for apartment in apartments %}
                        {% if apartment.nettomietzins %}
                            {{ apartment.nettomietzins|replace({'CHF ': '', ',': '', '.': ''})|trim }},
                        {% endif %}
                    {% endfor %}
                ];
                if (prices.length > 0) {
                    minPrice = Math.floor(Math.min(...prices) / 100) * 100; // Runde auf 100er
                    maxPrice = Math.ceil(Math.max(...prices) / 100) * 100;
                }
            {% endif %}

            // noUiSlider initialisieren
            var slider = document.getElementById('nettomiete-slider');
            noUiSlider.create(slider, {
                start: [minPrice, maxPrice],
                connect: true,
                step: 50,
                range: {
                    'min': minPrice,
                    'max': maxPrice
                },
                format: {
                    to: function(value) {
                        return Math.round(value);
                    },
                    from: function(value) {
                        return Number(value);
                    }
                }
            });

            // Werte anzeigen
            slider.noUiSlider.on('update', function(values, handle) {
                document.getElementById('min-value').textContent = values[0];
                document.getElementById('max-value').textContent = values[1];
            });

            // DataTables Custom Filter für Slider
            $.fn.dataTable.ext.search.push(
                function(settings, data, dataIndex) {
                    var sliderValues = slider.noUiSlider.get();
                    var min = parseFloat(sliderValues[0]);
                    var max = parseFloat(sliderValues[1]);
                    var nettomiete = parseFloat(data[7].replace(/[^0-9.-]+/g,"")) || 0;

                    if (nettomiete >= min && nettomiete <= max) {
                        return true;
                    }
                    return false;
                }
            );

            // DataTables initialisieren
            var table = $('#apartments-table').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/de-DE.json'
                },
                pageLength: 25,
                lengthChange: false,
                searching: false,
                order: [[0, 'asc']],
                columnDefs: [
                    {
                        targets: [11],
                        orderable: false,
                        searchable: false
                    }
                ],
                initComplete: function () {
                    // Filter für Select-Spalten
                    this.api().columns([2, 3, 4, 10]).every(function () {
                        var column = this;
                        var select = $('<select class="dt-filter"><option value="">Alle</option></select>')
                            .appendTo($(column.header()))
                            .on('change', function () {
                                var val = $.fn.dataTable.util.escapeRegex($(this).val());
                                column.search(val ? '^' + val + '$' : '', true, false).draw();
                            });

                        column.data().unique().sort().each(function (d, j) {
                            var text = $(d).text() || d;
                            if (text && text !== '-') {
                                select.append('<option value="' + text + '">' + text + '</option>');
                            }
                        });
                    });
                }
            });

            // Slider Event - Tabelle neu filtern
            slider.noUiSlider.on('change', function() {
                table.draw();
            });
        });
        </script>
    {% endif %}
</div>