<div class="mod_apartments_list">
    <div class="apartments-list">
        {% if apartments is empty %}
            <p class="no-apartments">Aktuell sind keine Wohnungen verfügbar.</p>
        {% else %}
            <div class="apartments-grid">
                {% for apartment in apartments %}
                    <div class="apartment-item status-{{ apartment.status|lower }}">
                        <div class="apartment-header">
                            <h3>{{ apartment.bezeichnung }}</h3>
                            <span class="apartment-number">{{ apartment.objektnummer }}</span>
                        </div>
                        
                        <div class="apartment-details">
                            <div class="detail-row">
                                <strong>Adresse:</strong> {{ apartment.adresse }}
                            </div>
                            <div class="detail-row">
                                <strong>Etage:</strong> {{ apartment.etage }}
                            </div>
                            <div class="detail-row">
                                <strong>Zimmer:</strong> {{ apartment.zimmer }}
                            </div>
                            <div class="detail-row">
                                <strong>Fläche:</strong> {{ apartment.flaeche }} m²
                            </div>
                        </div>

                        <div class="apartment-costs">
                            <div class="cost-item">
                                <span class="cost-label">Nettomiete:</span>
                                <span class="cost-value">CHF {{ apartment.nettomietzins }}</span>
                            </div>
                            <div class="cost-item">
                                <span class="cost-label">Nebenkosten:</span>
                                <span class="cost-value">CHF {{ apartment.nebenkosten }}</span>
                            </div>
                            <div class="cost-item total">
                                <span class="cost-label">Bruttomiete:</span>
                                <span class="cost-value">CHF {{ apartment.bruttomietzins }}</span>
                            </div>
                        </div>

                        <div class="apartment-status status-{{ apartment.status|lower }}">
                            {{ apartment.status }}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>