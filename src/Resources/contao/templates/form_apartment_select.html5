<?php $this->extend('form_row'); ?>

<style>
.widget-select select option.optgroup-label {
    color: #000;
    font-weight: bold;
    font-style: normal;
}
.widget-select select option:not(.optgroup-label) {
    font-weight: normal;
}
</style>

<?php $this->block('label'); ?>
  <?php if ($this->label): ?>
    <label for="ctrl_<?= $this->id ?>"<?php if ($this->class): ?> class="<?= $this->class ?>"<?php endif; ?>>
      <?php if ($this->mandatory): ?><span class="invisible"><?= $this->mandatoryField ?> </span><?php endif; ?>
      <?= $this->label ?>
      <?php if ($this->mandatory): ?><span class="mandatory">*</span><?php endif; ?>
    </label>
  <?php endif; ?>
<?php $this->endblock(); ?>

<?php $this->block('field'); ?>
  <?= $this->widget ?>
  <?php if ($this->hasErrors()): ?>
    <p class="error"><?= $this->getErrorAsString() ?></p>
  <?php endif; ?>
<?php $this->endblock(); ?>
