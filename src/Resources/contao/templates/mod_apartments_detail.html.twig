 <div class="mod_apartments_detail">
    {% if error %}
        <div class="alert alert-warning">{{ error }}</div>
        <a href="javascript:history.back()" class="btn btn-back">Zurück zur Übersicht</a>
    {% elseif apartment %}
        <div class="apartment-detail">
            <div class="detail-header">
                {% if apartment.bezeichnung %}
                    <h1>{{ apartment.bezeichnung }}</h1>
                {% endif %}
                {% if apartment.objektnummer %}
                    <p class="objektnummer">Objekt-Nr.: {{ apartment.objektnummer }}</p>
                {% endif %}
                {% if apartment.status %}
                    <div class="status-badge status-{{ apartment.status|lower }}">
                        {{ apartment.status }}
                    </div>
                {% endif %}
            </div>

            <div class="detail-content">
                <div class="detail-section">
                    <h2>Allgemeine Informationen</h2>
                    <dl class="info-list">
                        {% if apartment.adresse %}
                            <dt>Adresse:</dt>
                            <dd>{{ apartment.adresse }}</dd>
                        {% endif %}
                        {% if apartment.bauetappe %}
                            <dt>Bauetappe:</dt>
                            <dd>{{ apartment.bauetappe }}</dd>
                        {% endif %}
                        {% if apartment.zeile %}
                            <dt>Zeile:</dt>
                            <dd>{{ apartment.zeile }}</dd>
                        {% endif %}
                        {% if apartment.etage %}
                            <dt>Etage:</dt>
                            <dd>{{ apartment.etage }}</dd>
                        {% endif %}
                        {% if apartment.zimmer %}
                            <dt>Anzahl Zimmer:</dt>
                            <dd>{{ apartment.zimmer }}</dd>
                        {% endif %}
                        {% if apartment.flaeche %}
                            <dt>Wohnfläche:</dt>
                            <dd>{{ apartment.flaeche }} m²</dd>
                        {% endif %}
                    </dl>
                </div>

                {% if apartment.nettomietzins or apartment.nebenkosten or apartment.bruttomietzins %}
                    <div class="detail-section costs-section">
                        <h2>Mietkosten</h2>
                        <dl class="costs-list">
                            {% if apartment.nettomietzins %}
                                <dt>Nettomiete:</dt>
                                <dd>CHF {{ apartment.nettomietzins }}</dd>
                            {% endif %}
                            {% if apartment.nebenkosten %}
                                <dt>Nebenkosten:</dt>
                                <dd>CHF {{ apartment.nebenkosten }}</dd>
                            {% endif %}
                            {% if apartment.bruttomietzins %}
                                <dt class="total">Bruttomiete (inkl. NK):</dt>
                                <dd class="total"><strong>CHF {{ apartment.bruttomietzins }}</strong></dd>
                            {% endif %}
                        </dl>
                    </div>
                {% endif %}

                {% if apartment.imagegrundriss_path or apartment.imageetage_path %}
                    <div class="detail-section images-section">
                        <h2>Pläne & Ansichten</h2>
                        <div class="images-grid">
                            {% if apartment.imagegrundriss_path %}
                                <div class="image-item">
                                    <h3>Grundriss</h3>
                                    <img src="{{ apartment.imagegrundriss_path }}" alt="Grundriss {{ apartment.bezeichnung }}">
                                </div>
                            {% endif %}
                            {% if apartment.imageetage_path %}
                                <div class="image-item">
                                    <h3>Etagenplan</h3>
                                    <img src="{{ apartment.imageetage_path }}" alt="Etagenplan {{ apartment.bezeichnung }}">
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                {% if apartment.grundrisspdf_path %}
                    <div class="detail-section download-section">
                        <h2>Downloads</h2>
                        <a href="{{ apartment.grundrisspdf_path }}" class="btn btn-download" download>
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
                                <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/>
                            </svg>
                            {{ apartment.grundrisspdf_name|default('Grundriss') }} herunterladen
                        </a>
                    </div>
                {% endif %}
            </div>

            <div class="detail-footer">
                <a href="javascript:history.back()" class="btn btn-back">← Zurück zur Übersicht</a>
            </div>
        </div>
    {% endif %}
</div>